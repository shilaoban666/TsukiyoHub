# ============================================================================
# TsukiyoHub 配置示例：复制为 .env 后按需修改
#   Copy-Item .env.example .env
# 全部字段都有默认值——**不填密钥也能启动**（模型与向量化自动降级）。
# ============================================================================

# ------------------------------------------------------------------ 基础
APP_NAME=TsukiyoHub
APP_ENV=local                 # local / dev / test / staging / prod
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://127.0.0.1:8080
# 允许跨域的前端地址，逗号分隔；* = 全部（仅限本地/内网）
CORS_ORIGINS=*

# 对外 API 鉴权：留空 = 不鉴权；填了则要求 Authorization: Bearer <key>
API_KEY=
# 每 IP 每分钟请求上限（0 = 不限）
RATE_LIMIT_PER_MINUTE=0

# ------------------------------------------------------------------ 大模型
# 走 OpenAI 兼容协议：OpenAI / DeepSeek / 通义千问 / vLLM / Ollama / 中转站都可以
LLM_PROVIDER=openai           # openai / dashscope / deepseek / fake（fake=无密钥演示）
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 常用组合示例：
#   通义千问： LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   DeepSeek： LLM_BASE_URL=https://api.deepseek.com/v1                       LLM_MODEL=deepseek-chat
#   Ollama：   LLM_BASE_URL=http://127.0.0.1:11434/v1                         LLM_MODEL=qwen2.5:7b
# 备用模型（主模型失败时自动切换）
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 思考型模型（qwen / deepseek-v4 系列）默认关闭深度思考，显著降低首字延迟
LLM_THINKING=false

# ------------------------------------------------------------------ 向量化
EMBEDDING_ENABLED=true
# openai / dashscope 需要 API Key；hash = 零依赖演示（词面哈希无语义 → 检索退化为纯关键词 BM25）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10
# 通义千问示例：EMBEDDING_PROVIDER=dashscope  EMBEDDING_MODEL=text-embedding-v3  EMBEDDING_DIMENSION=1024
#                  EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 完全离线演示：EMBEDDING_PROVIDER=hash  VECTOR_BACKEND=memory  LLM_PROVIDER=fake
#   （此时没有语义向量，检索与命中判定都走 BM25 关键词，开箱即可看到引用效果）

# -------------------------------------------------------------- 知识库 / 检索
KB_AUTO_LOAD_INDEX=true
CHUNK_SIZE=700
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=32

RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_K=20
RETRIEVAL_BM25_K=20
RETRIEVAL_FUSION_K=60
RETRIEVAL_VECTOR_WEIGHT=0.6
RETRIEVAL_BM25_WEIGHT=0.4
RETRIEVAL_MIN_SCORE=0.0
RERANK_ENABLED=false
RERANK_MAX_CHUNKS=4

# ------------------------------------------------------------------ 向量库
# memory = 进程内混合检索（零依赖，默认，适合单机/演示/测试）
# milvus = 生产检索后端（需要 Milvus 2.4+）
VECTOR_BACKEND=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=tsukiyo_chunks
MILVUS_TIMEOUT_SECONDS=5

# 原文件存储：local = data/files（默认）；oss = 阿里云 OSS / S3 兼容
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_PREFIX=kb/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ------------------------------------------------------- 命中判定 / 防幻觉
# 检索结果最高向量余弦低于该值 → 判定「知识库里没有」，如实说不知道。
# ⚠️ 换 embedding 模型后必须重新标定（不同模型分布差异很大）。
GROUNDING_MIN_SCORE=0.35
# 逐句核对：strict = 删掉资料不支持的句子；lenient = 只告警；off = 关闭
ANSWER_JUDGE=strict
JUDGE_TIMEOUT_SECONDS=12

# ------------------------------------------------------------------ 数据库
# 留空 = data/tsukiyohub.db（SQLite，开箱即用）
# 生产：postgresql+psycopg://user:pass@127.0.0.1:5432/tsukiyohub
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ------------------------------------------------------------------ Redis（可选）
# 留空 = 不用 Redis，全部读写数据库（单副本足够）
REDIS_URL=

# ------------------------------------------------------------------ 对话
SEGMENT_IDLE_MINUTES=30
MAX_TOOL_ROUNDS=3
KB_PREFETCH=true
HISTORY_MAX_TURNS=10
HISTORY_SUMMARY_AFTER=12
MAX_CONCURRENT_CHATS=32
DEFAULT_TONE=friendly        # formal / friendly / concise
DEFAULT_LENGTH=medium        # short / medium / long
DEFAULT_MARKDOWN=true
BOT_NAME=Tsukiyo
PERSONA_PROMPT=
FALLBACK_TEXT=抱歉，我暂时无法回答这个问题。
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ------------------------------------------------------------------ 技能
# SKILL.md 技能目录：留空 = data/skills（每个技能一个子目录，含 SKILL.md）
SKILLS_DIR=
# 默认启用的内置技能（逗号分隔）；不在列表里的内置技能默认停用
SKILLS_ENABLED=knowledge_search,web_fetch
# MCP server 配置（JSON 文件路径），留空 = 不启用 MCP
MCP_CONFIG_FILE=
SKILL_TIMEOUT_SECONDS=20
# 联网搜索（Tavily 兼容的 POST 端点）。留空 = web_search 技能不启用
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_FETCH_MAX_CHARS=8000
WEB_FETCH_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------ 记忆
MEMORY_ENABLED=true
MEMORY_MAX_FACTS=50
MEMORY_EXTRACT_TEMPERATURE=0

# ------------------------------------------------------------------ 其它
APP_TIMEZONE=Asia/Shanghai
APP_SECRET_KEY=